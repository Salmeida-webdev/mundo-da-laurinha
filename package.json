{
  "name": "o-mundo-da-laurinha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "cf:dev": "wrangler dev",
    "cf:migrate:local": "wrangler d1 migrations apply laurinha-db --local",
    "cf:migrate:remote": "wrangler d1 migrations apply laurinha-db --remote"
  },
  "dependencies": {
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-pwa": "^1.1.0",
    "vue-tsc": "^3.1.1",
    "wrangler": "^4.45.0"
  }
}
